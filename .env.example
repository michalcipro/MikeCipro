# ─────────────────────────────────────────────────────────────────────
#  INSTAGRAM  (profesionální účet — Business nebo Creator)
#  Postup, jak tyhle dvě hodnoty získat, je v README.
# ─────────────────────────────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# Potřeba jen pro `igagent token exchange` (prodloužení tokenu na 60 dní)
FB_APP_ID=
FB_APP_SECRET=

GRAPH_API_VERSION=v23.0

# ─────────────────────────────────────────────────────────────────────
#  CLAUDE
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_EFFORT=high

# ─────────────────────────────────────────────────────────────────────
#  HOSTING MÉDIÍ
#  Instagram si soubor stahuje z veřejné URL — musí být odkudsi dostupný.
#
#  local:  soubory z OUT_DIR servíruje tvůj web/nginx na MEDIA_PUBLIC_BASE
#  s3:     AWS S3 / Cloudflare R2 / Backblaze B2 (vyžaduje `pip install boto3`)
# ─────────────────────────────────────────────────────────────────────
MEDIA_HOST=local
MEDIA_PUBLIC_BASE=

# S3_BUCKET=muj-bucket
# S3_PREFIX=ig
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────────────
#  CHOVÁNÍ AGENTA
#
#  AUTOPILOT=off     jen měří a navrhuje, nic nepublikuje
#  AUTOPILOT=review  vyrobí a naplánuje, publikuje až po tvém schválení  ← doporučeno na začátek
#  AUTOPILOT=full    publikuje sám podle plánu
# ─────────────────────────────────────────────────────────────────────
AUTOPILOT=review
TIMEZONE=Europe/Prague
MAX_POSTS_PER_DAY=2
MIN_HOURS_BETWEEN_POSTS=5
QUEUE_LOOKAHEAD_DAYS=7

# Jak často agent zkouší nové varianty místo osvědčených (0–1)
EXPLORE_RATE=0.25

# Nechat Claude vizuálně zkontrolovat grafiku před publikací
QA_IMAGES=1

METRICS_COLLECT_AFTER_HOURS=24
METRICS_REFRESH_DAYS=14
LOG_LEVEL=INFO
